# SleepCare — 루트 `.env` 템플릿 (복사: `.env.sample` → `.env` 후 값 입력)
# 백엔드(spring-dotenv)와 프론트(Vite)가 동일 파일을 사용합니다. 저장소 루트에서 `npm run dev` 권장.

# --- Vite (`VITE_` 접두사만 브라우저 번들에 포함) ---
VITE_API_BASE_URL=

# --- Spring: DB (프로파일별로 쓰는 URL만 채우면 됩니다) ---
DATASOURCE_DB_NAME=

DATASOURCE_URL_LOCAL=
DATASOURCE_USERNAME_LOCAL=
DATASOURCE_PASSWORD_LOCAL=

DATASOURCE_URL_DEV=
DATASOURCE_USERNAME_DEV=
DATASOURCE_PASSWORD_DEV=

DATASOURCE_URL_PROD=
DATASOURCE_USERNAME_PROD=
DATASOURCE_PASSWORD_PROD=

# --- Spring: JWT ---
JWT_SECRET_KEY=
JWT_EXPIRED_IN=

# --- Fitbit ---
FITBIT_ACCESS_TOKEN=
FITBIT_REFRESH_TOKEN=
USER_PASSWORD=

# --- Spring: 선택 (application.yml 기본값 있음) ---
FRONTEND_ORIGIN=
FITBIT_SYNC_INTERVAL_MS=
MQTT_BROKER_URL=
MQTT_CLIENT_ID=
MQTT_TOPIC=
MQTT_TARGET_USER_ID=
MQTT_ALARM_CLIENT_ID=
MQTT_ALARM_TOPIC=
MQTT_ALARM_SCHEDULE_TOPIC=
MQTT_PUBLISH_SCHEDULE_TO_RASPBERRY=

# --- AWS Bedrock + S3 (페르소나 프롬프트 + 논문 KB) ---
AI_AWS_REGION=
AI_S3_BUCKET=
AI_BEDROCK_KB_ID=
AI_BEDROCK_MODEL_ARN=
AI_PROMPT_KEY_DASHBOARD=
AI_PROMPT_KEY_CHATBOT=
AI_PROMPT_TTL_SECONDS=
AI_CHATBOT_MAX_TOOL_ROUNDS=
AI_CHATBOT_CONVERSE_MODEL_ARN=
